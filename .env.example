# =====================================================================
# EvalixAI — environment configuration (copy to .env and edit)
#
# Everything in the platform is soft-coded from this file. No secrets,
# URLs or credentials live in source code. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_hex(48))"
# =====================================================================

# ------------------------- Auth (REQUIRED) ---------------------------
# JWT signing secret for access tokens (>= 32 chars). NEVER commit real values.
JWT_ACCESS_SECRET=change-me-generate-a-long-random-string-min-32-chars

# Access/refresh lifetimes (seconds) — 15 min / 7 days
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Password hashing cost (bcrypt rounds) and brute-force policy
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Fixed-window rate limits, "requests/seconds"
RATE_LOGIN_IP=10/900
RATE_LOGIN_ACCOUNT=6/900
RATE_REGISTER=5/3600

# ------------------------- Frontend (Next.js) ------------------------
# Where the browser finds the FastAPI backend.
#   docker compose : keep the default (host-mapped port 8000)
#   local npm dev  : same default works when backend runs on :8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Browser origins allowed by the API (CORS + Origin CSRF check), comma-separated
FRONTEND_ORIGINS=http://localhost:3000

# ------------------------- MongoDB (primary store) -------------------
# docker compose: mongodb://mongo:27017 (set automatically)
# local dev    : mongodb://127.0.0.1:27017
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=evalixai

# ------------------------- Redis (sessions/limits/cache) -------------
# docker compose: redis://:${REDIS_PASSWORD}@redis:6379 (set automatically)
REDIS_URL=redis://:evalix_redis_2024@127.0.0.1:6379
REDIS_PASSWORD=evalix_redis_2024

# ------------------------- Qdrant (semantic matching) -----------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=candidate_profiles
EMBEDDING_DIM=256
ENABLE_VECTOR_SEARCH=true

# ------------------------- Object storage (S3-compatible) ------------
# Works with SeaweedFS (bundled — the open-source MinIO server was
# archived upstream), Garage, or any real S3 endpoint.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=evalix_minio
MINIO_SECRET_KEY=evalix_minio_2024
MINIO_BUCKET=resumes
MINIO_SECURE=false
PRESIGN_EXPIRE_SECONDS=900
ENABLE_OBJECT_STORAGE=true

# ------------------------- AI provider (KodeKloud) -------------------
# "heuristic" = fully offline deterministic matching (default)
# "kodekloud" = call the external API for embeddings/evaluations
AI_PROVIDER=heuristic
KODEKLOUD_API_BASE_URL=
KODEKLOUD_API_KEY=
AI_TIMEOUT_SECONDS=30

# ------------------------- App behaviour ------------------------------
ENVIRONMENT=development        # development | staging | production
DOCS_ENABLED=true              # FastAPI /docs + /redoc (disable in prod)
TRUST_PROXY=false              # true only behind a trusted reverse proxy
MAX_BODY_BYTES=1048576         # 1 MiB JSON cap (files go via presigned PUT)
